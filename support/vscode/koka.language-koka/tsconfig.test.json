{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "out",
        "rootDir": "src",
        "module": "commonjs",
        "target": "es2020",
        "lib": ["es2020"],
        "sourceMap": true,
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node", "mocha", "vscode"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", ".vscode-test", "dist"]
}
