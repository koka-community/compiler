// -----------------------------------------------------------------------------
// ALEX TEMPLATE
// -----------------------------------------------------------------------------
// This code is in the PUBLIC DOMAIN; you may copy it freely and use
// it for any purpose whatsoever.

// -----------------------------------------------------------------------------
// Main lexing routines

// import std/core/undiv

effect alex
  // Lexer state
  fun push-state(i: int): () // Push a new state onto the stack
  fun pop-state(): int // Pop the current state off the stack
  fun replace-state(i: int): () // Pop the current state off the stack, and add the new one
  fun get-state(): int // Gets the current state of the stack
  // Lexer input movement
  fun next-char(): maybe<int> // Gets the next character in the input
  fun prev-char(): int // Gets the previous character in the input
  fun consume-char(): () // Consumes the current character, adding it to the accepted input
  // Lexer accepting finished tokens and info
  fun set-accept(s: int): () // Sets the latest potential accepting state, while still seeking for states that accept more input
  fun recognize-token(): alex-acc-res // Recognizes that the last accepting state is the longest accepting token, and prepares to start the next token
  fun action-info(): action-info // Get the info about the last token recognized (start, end, and slice) for the action
 
pub value type alex-pos
  AlexPos(
    offset: int,
    column: int,
    line: int
  )

// alias alex-eff = <pure, alex>
// alias handled-alex-eff = <pure>
// val alex-actions: vector<action> = [].vector
// val alex-accept: vector<alex-acc> = [].vector
// val alex-base : vector<int> = [].vector
// val alex-check : vector<int> = [].vector
// val alex-table : vector<int> = [].vector
// val alex-deflt : vector<int> = [].vector

alias alex-eff = <pure,alex,koka-lex>
alias handled-alex-eff = <pure,koka-lex>

fun pos-move(AlexPos(o, line, col): alex-pos, c: int): alex-pos
  val o1 = if o < 0 then o else o+1
  match c.char
    '\n' -> AlexPos(o1, line + 1, 1)
    _    -> AlexPos(o1, line, col + 1)

alias action = () -> alex-eff ();

type action-info
  ActionInfo(
    token: bslice,
    start: alex-pos,
    end: alex-pos
  )

fun get-slice(): _ bslice
  action-info().token

fun get-sslice(): _ sslice
  get-string().slice

fun get-string(): _ string
  get-slice().bytes.string

fun get-start(): _ alex-pos
  action-info().start

fun get-end(): _ alex-pos
  action-info().end

value type alex-acc
  AlexAccNone
  AlexAcc(a: int)
  AlexAccSkip

// Offsets into the scan's input rather than slices: `set-accept` runs on every
// accepting character, and a slice carries a `bytes` reference that has to be
// dup'ed and dropped with it. As scalars this is a value type -- setting the
// accept state costs nothing.
value type alex-acc-res
  AlexAccResNone
  AlexAccRes(action: int, next: int, acc: int, acc-end: int, end: alex-pos)
  AlexAccResSkip(next: int, acc: int, acc-end: int)

// The scan state holds the input ONCE and everything else as integer offsets
// into it, not as separate `bslice`s (seeked position, the position one
// character back, the accepted span) into the same buffer: a `bslice` is a
// value struct carrying a `bytes` reference, so each would be dup'ed and
// dropped every time the state is updated, which happens once per INPUT
// CHARACTER. Offsets are scalars and cost nothing.
//
// All offsets are relative to `input`, so `input.byte-at(seek)` reads and
// `input.subslice(acc, acc-end - acc)` materialises a span when an action wants
// one -- once per token instead of once per character.
type alex-scan-state
  AlexScanState(
    states: list<int>,
    input: bslice, // The whole input; the only reference here, and never changes
    input-len: int, // `input.length`, kept as a scalar so EOF tests never project `input`
    seek: int, // Offset of the seeked position
    // on an error, we want to keep the input *before* the
    // character that failed, not after.
    current: int, // Trails the seeked position by one
    acc: int, // Start of the current 'accepted' portion
    acc-end: int, // End of the current 'accepted' portion
    prev: int, // Previous character
    curr: int, // Current character
    start: alex-pos, // File position of the start of the current token
    end: alex-pos, // File position of the end of the current token
    last-accept: alex-acc-res, // The last accepting state encountered
    action-info: action-info // The action info
  )

// Consumes the current character, adding it to the accepted input for this token
fun alex-consume-char(a: alex-scan-state)
  match a
    AlexScanState(states, input, ilen, seek, current, acc, acc-end, prev, curr, start, end, last-accept, action-info) ->
      AlexScanState(states, input, ilen, seek, current, acc, acc-end + 1, prev, curr, start, end.pos-move(curr), last-accept, action-info)

pub value type alex-next
  AlexNext(
    s: alex-scan-state,
    c: int
  )

// Moves the current to the seeked position, and moves the seeked position to the next character
fun alex-next(a: alex-scan-state): (maybe<alex-next>)
  match a
    AlexScanState(states, input, ilen, seek, _, acc, acc-end, _, curr, start, end, last-accept, action-info) ->
      if seek >= ilen then Nothing
      else
        val c = input.byte-at(seek)
        Just(AlexNext(AlexScanState(states, input, ilen, seek + 1, seek, acc, acc-end, curr, c, start, end, last-accept, action-info), c))

// `alex-next` in the shape `local-var/update` wants: `a -> a`, so the state can
// be handed over by OWNERSHIP and updated IN PLACE instead of being read (which
// dups it), rebuilt, and freed once per input character. End-of-input is tested
// by the caller with `is-empty` rather than reported here, precisely so this
// stays `a -> a` -- and so `curr`/`prev` keep their meaning at EOF instead of
// needing a sentinel that `alex-consume-char`'s `pos-move(curr)` would then
// have to defend against.
//
// Total, like `alex-consume-char` -- which `update` requires and enforces.
fun alex-advance(a: alex-scan-state): alex-scan-state
  match a
    AlexScanState(states, input, ilen, seek, _, acc, acc-end, _, curr, start, end, last-accept, action-info) ->
      if seek >= ilen then a
      else
        val c = input.byte-at(seek)
        AlexScanState(states, input, ilen, seek + 1, seek, acc, acc-end, curr, c, start, end, last-accept, action-info)

fun do-alex-accept(a: alex-scan-state, s: int) // Sets the accepting state
  match a
    AlexScanState(states, input, ilen, seek, current, acc, acc-end, prev, curr, start, end, last-accept, action-info) ->
      match alex-accept.unchecked-idx(s.ssize_t)
        AlexAccNone -> 
          AlexScanState(states, input, ilen, seek, current, acc, acc-end, prev, curr, start, end, last-accept, action-info) // Just use the previous accepting state
        AlexAcc(act) -> 
          // New accepting state with this accumlated input and end, and the action associated with it
          AlexScanState(states, input, ilen, seek, current, acc, acc-end, prev, curr, start, end, AlexAccRes(act, seek, acc, acc-end, end), action-info)
        AlexAccSkip -> 
          // An accepting state that skips over this input
          AlexScanState(states, input, ilen, seek, current, acc, acc-end, prev, curr, start, end, AlexAccResSkip(seek, acc, acc-end), action-info)

// Recognizes the last accepting state as the longest accepting token
fun recognize(a: alex-scan-state, restart: bool)
  match a
    AlexScanState(states, input, ilen, seek, current, acc, acc-end, prev, curr, start, end, last-accept, action-info) ->
      match last-accept
        AlexAccResNone ->  
          if seek >= ilen then // Check if we are at the end of the input
            // EOF
            AlexScanState(states, input, ilen, seek, current, acc, acc-end, prev, curr, start, end, last-accept, action-info)
          else
            // Try skipping the first character, and start again (`restart` selected
            // the same state on both sides before this rewrite, and still does)
            AlexScanState(states, input, ilen, seek, seek, seek, seek, 0, 0, end, end, AlexAccResNone, action-info)
        AlexAccRes(_, resnext, resacc, resacc-end, resend) ->
          // the accepted span is materialised HERE, once per token, rather than
          // being carried as a slice through every character
          AlexScanState(states, input, ilen, resnext, resnext, resnext, resnext, 0, 0, resend, resend, AlexAccResNone,
                        ActionInfo(input.subslice(resacc, resacc-end - resacc), start, resend))
        AlexAccResSkip(resnext) ->
          AlexScanState(states, input, ilen, resnext, resnext, resnext, resnext, 0, 0, end, end, AlexAccResNone, action-info)

pub fun alex-scan(input: bslice, sc: int, restart:bool=False): _ ()
  val ilen = input.length
  var state := AlexScanState([sc], input, ilen, 0, 0, 0, 0, 0, 0, AlexPos(0,1,1), AlexPos(0,1,1), AlexAccResNone, ActionInfo(input.subslice(0, 0), AlexPos(0,1,1), AlexPos(0,1,1)))
  with handler
    fun get-state()
      match state.states // Get the current lexer state (i.e. the state to start the next token in)
        Cons(s) -> s
    // `update` rather than `state := ...`: it hands OWNERSHIP of the value to
    // the function (see `local-var/update` in std/core/types, from koka#716),
    // so the record arrives uniquely referenced and `alex-consume-char` and
    // friends can update it IN PLACE. Reading `state` instead dups it, the
    // reuse branch cannot fire, and every step allocates a fresh 10-field
    // record and drops the old one -- which is why FREE alone was 16.9% of a
    // warm interface load. The update function must be total and must not
    // touch the var itself, which is why each one takes the record as an
    // argument.
    fun push-state(i)
      std/core/types/@byref(state).update(fn(st) st(states = Cons(i, st.states)))
    fun replace-state(i)
      std/core/types/@byref(state).update fn(st)
        match st.states
          Cons(_, rest) -> st(states = Cons(i, rest))
          _             -> st
    fun pop-state() // Pop the current state off the stack
      match state.states
        Cons(s, ss) -> 
          state := state(states=ss)
          s
        _ -> throw("No states to pop.")
    fun next-char() 
      // test EOF first, then advance in place; `maybe` is a value type so the
      // Just/Nothing themselves cost nothing
      if state.seek >= state.input-len then Nothing
      else
        std/core/types/@byref(state).update(alex-advance)
        Just(state.curr)
    fun consume-char() 
      std/core/types/@byref(state).update(alex-consume-char)
    fun prev-char() // Gets the previous character
      state.prev
    fun action-info() // Gets the info for the action
      state.action-info
    fun set-accept(s) // Sets the accepting state
      std/core/types/@byref(state).update(fn(st) st.do-alex-accept(s))
    fun recognize-token() 
      val la = state.last-accept
      state := state.recognize(restart) 
      la
  alex-scan-tokens(sc)

inline fun do-recognize-token(): _ ()
  val la = recognize-token() // Changes last accept, so we get it prior
  match la
    AlexAccRes(a) ->
      alex-actions.unchecked-idx(a.ssize_t)()
    _ -> ()

// Push the input through the DFA, remembering the most recent accepting
// state it encountered.
fun alex-scan-tokens(s: int): _ ()
  set-accept(s)
  val mc = next-char()
  match mc
    Nothing -> 
      do-recognize-token()
    Just(ord_c) ->
      val base = alex-base.unchecked-idx(s.ssize_t)
      val offset = base + ord_c
      // guard the offset before reading: unlike GHC Addr# reads, an out-of-bounds
      // unchecked-idx can fault (the check table is not padded for all base+byte offsets)
      val check  = if offset >= 0 && offset < alex-check.length then alex-check.unchecked-idx(offset.ssize_t) else -1
      val new_s = if check == ord_c
                      then alex-table.unchecked-idx(offset.ssize_t)
                      else alex-deflt.unchecked-idx(s.ssize_t)
      match new_s
          -1 -> 
            do-recognize-token()
            alex-scan-tokens(get-state())
          _ ->
            consume-char()
            alex-scan-tokens(new_s)
/// LINE 259 "compiler/syntax/koka.x"
fun is-anglebar(c: char): bool
  match c
    '|' -> True
    '<' -> True
    '>' -> True
    _ -> False

fun split-op(s: string): list<lex>
  fun split(s': list<char>): list<lex>
    match s'
      Cons('|', rst) | rst.all(fn(r) r.is-anglebar) -> Cons(LexKeyword("|", ""), split(rst))
      Cons('>', rst) -> Cons(LexOp(">".new-name), split(rst))
      Cons('<', rst) -> Cons(LexOp("<".new-name), split(rst))
      Nil -> Nil
      xs -> Cons(LexOp(xs.string.new-name), Nil)
  val sl = s.list
  if sl.all(fn(c) c.is-anglebar) then // A type operator
    split(sl)
  else Cons(LexOp(s.new-name), Nil)

fun extend-span(): <alex,koka-lex> ()
  extend-chunk(get-start().offset, get-end().offset)

fun pop-rawdelim()
  set-rawdelim(0)

fun push-rawdelim()
  set-rawdelim(get-sslice().count - 2)

fun get-name()
  get-string().new-name

fun get-qname()
  get-string().read-qualified-name

fun unsafe-char(kind: string)
  LexError("unsafe character in " ++ kind ++ ": " ++ get-string())
  end-chunked()
  pop-state()
  ()

fun strip-parens(s: sslice)
  match s.string.list.reverse
    Cons(')', cs) -> 
      match cs.span(fn(c) { c != '(' })
        (op, Cons('(', qual)) -> (op ++ qual).reverse.string
        _ -> s.string
    _ -> s.string


// Reserved
val special-names = [ "{", "}"
    , "(", ")"
    , "<", ">"
    , "[", "]"
    , ";", ","
]
// A fixed keyword set: build it as a PURE IMMUTABLE trie, not a lazy `delay`
// around `string-pool()`, whose named handler closes over a mutable
// `var trie`. Forcing a lazy thunk mutates it, and each parallel worker gets
// its own Koka heap/refcount domain, so two workers forcing one
// concurrently is a use-after-free (EXC_BAD_ACCESS in tuple2_unbox, with
// another thread inside kk_block_fast_drop_free). Nothing here needs
// interning or laziness.
// the same words as `reserved-names`, as a LIST: a trie cannot be enumerated,
// and the language server offers keyword completions from it
pub val reserved-name-list : list<string> =
        ["infix", "infixr", "infixl"
              , "module", "import", "as"
              , "pub", "abstract"
              , "type", "alias", "effect", "struct", "con"
              , "forall", "exists", "some"
              , "fun", "fn", "val", "var", "extern"
              , "if", "then", "else", "elif"
              , "match", "return", "with", "in"
              , "handle", "handler", "mask"
              , "ctl", "final", "raw"
              , "override", "named"
              , "ctx", "hole"

              // deprecated
              , "private", "public"  // use pub
              , "rawctl", "brk"      // use raw ctl, and final ctl
              , "prefix", "postfix"

              // alternative names for backwards paper compatability
              , "control", "rcontrol", "except"
              , "ambient", "context" // use effcet
              , "inject"       // use mask
              , "use", "using" // use with instead
              , "function"     // use fun
              , "instance"     // use named

              // future reserved
              , "interface"
              , "unsafe"
              , "break"
              , "continue"

              // operators
              , "="
              , "."
              , ":"
              , "->"
              , "<-"
              , ":="
              , "|"]

pub val reserved-names : trie =
        reserved-name-list.foldl(trie/empty(), fn(t, w) t.add(w))

fun is-reserved(name: string)
  reserved-names.lookup(name).is-just

fun is-prefix-op(name: string)
  name == "!" || name == "~"

fun string/is-malformed(name: string)
  name.list.charlist/is-malformed

fun is-at(c: char): bool
  c == '@'

// TODO: is-letter 
fun charlist/is-malformed(name: list<char>)
  match name
    // @ signs are added postpend to unique names (e.g. "x-@1") for variable x monadic lifted in a function (-).
    Cons('-', Cons(c, cs)) -> !(c.is-alpha || c.is-at) || cs.is-malformed 
    Cons(c, Cons('-', cs)) -> !(c.is-alpha || c.is-digit) || cs.is-malformed
    Cons(_, cs) -> cs.is-malformed
    Nil -> False

val message-malformed
  = "malformed identifier: a dash must be preceded by a letter or digit, and followed by a letter"

fun char/from-char-esc(c)
  match c
    'n' -> '\n'
    'r' -> '\r'
    't' -> '\t'
    _ -> c

// Decode a string literal's escapes over the WHOLE text, once, when the chunk is
// finalised. Decoding per match would make every chunk a transformed slice and
// so force the accumulate-and-copy shape; decoded at the end, every chunk in
// every state is a plain span of the input.
fun unescape-string(s: string): string
  fun hexval(cs: list<char>, n: int, acc: int): (int, list<char>)
    if n <= 0 then (acc, cs)
    else match cs
      Cons(c, rest) -> hexval(rest.pretend-decreasing, n - 1, acc * 16 + hex-digit-val(c.int))
      Nil -> (acc, Nil)
  fun go(cs: list<char>, acc: list<char>): list<char>
    match cs
      Nil -> acc.reverse
      Cons('\\', Cons(c, rest)) ->
        match c
          'x' ->
            val (v, r) = hexval(rest, 2, 0)
            go(r.pretend-decreasing, Cons(v.char, acc))
          'u' ->
            val (v, r) = hexval(rest, 4, 0)
            go(r.pretend-decreasing, Cons(v.char, acc))
          'U' ->
            val (v, r) = hexval(rest, 6, 0)
            go(r.pretend-decreasing, Cons(v.char, acc))
          _ -> go(rest.pretend-decreasing, Cons(char/from-char-esc(c), acc))
      Cons(c, rest) -> go(rest.pretend-decreasing, Cons(c, acc))
  go(s.list, []).string

fun bslice/from-char-esc(s: bslice): bslice
  // s is the matched `\<c>`; skip the backslash, decode the escape to the actual
  // character, and return it as a fresh single-char byte slice. (Previously this
  // returned the raw `\c` bytes, so string escapes were never decoded.)
  match s.next
    Just2(_, rest) -> match rest.next
      Just2(code, _) -> slice(string/bytes(char/string(char/from-char-esc(int/char(code)))))
      Nothing2 -> s
    Nothing2 -> s

fun hex-digit-val(c: int): int
  if c >= 0x30 && c <= 0x39 then c - 0x30      // 0-9
  elif c >= 0x41 && c <= 0x46 then c - 55      // A-F -> 10..15
  elif c >= 0x61 && c <= 0x66 then c - 87      // a-f -> 10..15
  else 0

// `s` is a slice over the hex digits of a `\xNN` / `\uNNNN` / `\UNNNNNN` escape
fun char/from-hex-esc(s: sslice)
  match s.string.parse-int(hex = True)
    Just(code) -> int/char(code)
    Nothing -> '\n'

// `s` is the matched `\<x|u|U><hexdigits>`; skip the backslash and prefix char,
// fold the remaining hex digits into a codepoint, and return its UTF-8 bytes.
fun bslice/from-hex-esc(s: bslice): bslice
  fun go(sl: bslice, acc: int): int
    match sl.next
      Just2(c, rest) -> go(rest.pretend-decreasing, acc * 16 + hex-digit-val(c))
      Nothing2 -> acc
  val code = match s.next
    Just2(_, r1) -> match r1.next
      Just2(_, r2) -> go(r2, 0)
      Nothing2 -> 0
    Nothing2 -> 0
  slice(string/bytes(char/string(int/char(code))))
