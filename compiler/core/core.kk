module compiler/core/core

import std/num/float64
import compiler/common/syntax
import compiler/common/name
import compiler/common/id
import compiler/common/name-prim
import compiler/common/range
import compiler/type/type
import compiler/type/kind
import compiler/kind/kind
import std/data/rb-set
import compiler/common/name-collections

pub fun is-unit(e: expr): bool
  match e
    Con(tn) | tn.get-name == name-tuple(0) -> True
    _ -> False

pub fun is-true(e: expr): bool
  match e
    Con(tn) | tn.get-name == nameTrue -> True
    _ -> False

pub fun is-false(e: expr): bool
  match e
    Con(tn) | tn.get-name == nameFalse -> True
    _ -> False

pub val exprUnit = Con(TName(nameUnit, typeUnit), ConEnum(nameTpUnit, DataEnum, zero, 0))

pub fun short-circuit(f: expr, args: list<expr>): maybe<expr>
  match args
    [e1, e2] -> 
      fun is-and-or(e: expr)
        match e
          App(TypeApp(Var(open)), [body]) -> 
            if open.get-name == nameEffectOpen then is-and-or(body)
            else Nothing
          Var(nm) ->
            if nm.get-name == nameAnd then Just(make-if-expr(e1, e2, exprFalse))   // x && y == if x then y else False
            elif nm.get-name == nameOr then Just(make-if-expr(e1, exprTrue, e2))   // x || y == if x then True else y
            else Nothing
          _ -> Nothing 
      is-and-or(f)
    _ -> Nothing

val pEFalse = pat-expr-bool(nameFalse, 0)
val patFalse = pEFalse.fst
pub val exprFalse = pEFalse.snd

val pETrue = pat-expr-bool(nameTrue, 1)
val patTrue = pETrue.fst
pub val exprTrue = pETrue.snd

fun pat-expr-bool(n: name, tag: int): (pattern, expr)
  val tn = TName(n, typeBool)
  val conEnum = ConEnum(nameTpBool, DataEnum, zero, tag)
  val conInfo = ConInfo(n, nameTpBool, [], [], [], TFun([], typeTotal, typeBool), Inductive, null, [], [], False, [], zero, Nothing, tag, Public, "")
  val pat = PatCon(tn, [], conEnum, [], [], typeBool, conInfo, False)
  val expr = Con(tn, conEnum)
  (pat, expr)

pub fun make-if-expr(p: expr, t: expr, f: expr): expr
  Case([p], [Branch([patTrue], [Guard(exprTrue, t)]), Branch([PatWild], [Guard(exprTrue, f)])])

pub fun make-vector(tp: ktype, exprs: list<expr>): expr
  val a = TypeVar(0, kindStar, Bound)
  val vectorFromList = Var(TName(nameVector, TForAll([a], TFun([(name/nil, TApp(typeList, [TVar(a)]))], typeTotal, TApp(typeVector, [TVar(a)])))), InfoArity(1, 1))
  App(TypeApp(vectorFromList, [tp]), [make-list(tp, exprs)])

pub fun wrap-optional(tp: ktype, ex: expr): expr
  val a = TypeVar(0, kindStar, Bound)
  val tpOptional = TForAll([a], TFun([(name/nil, TVar(a))], typeTotal, make-optional(TVar(a))))
  val conInfo = ConAsJust(nameTpOptional, DataAsMaybe, value-repr-scan(1), nameOptionalNone, 0)
  App(TypeApp(Con(TName(nameOptional, tpOptional), conInfo), [tp]), [ex])

fun make-list(tp: ktype, exprs: list<expr>): expr
  val a = TypeVar(0, kindStar, Bound)
  val nilTp = TForAll([a], TApp(typeList, [TVar(a)]))
  val nilCon = Con(TName(nameListNil, nilTp), ConSingleton(nameTpList, DataAsList, zero, 0))
  val nil = TypeApp(nilCon, [tp])
  val consTp = TForAll([a], TFun([(name/nil, TVar(a)), (name/nil, TApp(typeList, [TVar(a)]))], typeTotal, TApp(typeList, [TVar(a)])))
  val consCon = Con(TName(nameCons, consTp), ConAsCons(nameTpList, DataAsList, value-repr-scan(2), name/nil, CtxNone, 2))
  fun cons(e, xs)
    App(TypeApp(consCon, [tp]), [e, xs])
  exprs.foldr(nil, cons)

pub fun make-def(nm: name, e: expr): _ def
  Def(nm, type-of(e), e, Private, DefVal, InlineNever, null, "")

pub fun make-tdef(TName(nm, tp): tName, e: expr): _ def
  Def(nm, tp, e, Private, DefVal, InlineNever, null, "")

fun make-def-expr(expr: expr)
  make-def(name/nil, expr)

pub fun make-stats(l: list<expr>): _ expr
  match l
    Nil -> throw("core/core make-stats: no expression")
    Cons(e, Nil) -> e
    _ -> make-let(l.init.map(fn(expr) DefNonRec(make-def(name/nil, expr))), l.last.unjust)

pub fun make-defs-let(defs0: list<def>, expr0: expr)
  fun make(defs, e)
    match defs
      Nil -> e
      Cons(d, rdefs) | e.is-unit && def-name(d:def) == name/nil && defExpr(d:def).is-unit -> make(rdefs, d.defExpr)
      _ -> make-let(defs.reverse.map(DefNonRec), e)
  make(defs0.reverse, expr0)

//   This signifies that either a block
// if (is-unique(y)) { xUnique; free(y) } { xShared; xDecRef }
// or
// let ru = if (is-unique(y)) { xUnique; &y } { xShared; xDecRef; NULL }
// should be generated by reuse analysis after Parc.
// If this remains in the source after Reuse Analyis an error will be thrown!
pub fun make-drop-special(y: tName, xUnique: expr, xShared: expr, xDecRef: expr)
  val tp = TFun([y.type-of, xUnique.type-of, xShared.type-of, xDecRef.type-of].map((name/nil, _)), typeTotal, typeUnit)
  App(Var(TName(nameDropSpecial, tp), InfoExternal("")), [Var(y, InfoNone), xUnique, xShared, xDecRef])

pub struct core
  coreName: name
  imports: kimports = []
  fix-defs: fix-defs = []
  typedefs: typedef-groups = []
  defs: def-groups = []
  externals: externals = []
  doc: string = ""

pub fun core/show(c: core): div string
  "Core(" ++ c.coreName.name/name/show ++ "," ++ c.imports.show-list(show) ++ "," ++ c.fix-defs.show-list(show) ++ 
  "," ++ c.typedefs.show-list(fn(g) g.show-list(show)) ++ "," ++ c.defs.show-list(show) ++ "," ++ c.externals.show-list(show) ++ "," ++ c.doc.show ++ ")"

pub alias fix-defs = list<fix-def>;
pub value type fix-def
  FixDef(def-name: name, f: fixity);

pub fun fixd/show(f: fix-def): string
  match f
    FixDef(def-name, f') -> "FixDef(" ++ def-name.name/name/show ++ "," ++ show(f') ++ ")"

pub alias kimports = list<kimport>;

// `ImportProvenance`: why this import is part of the module's core
// (ImportUser: written by the user; ImportPub: pulled in via a pub re-export;
// ImportTypes: added for type-signature deps; ImportCompiler: added for
// inline-definition deps). Rendered in interfaces as ``/`pub`/`type`/`inline`.
pub type import-provenance
  ImportUser
  ImportPub
  ImportTypes
  ImportCompiler

pub struct kimport
  importName: name
  package: string
  visibility: visibility
  doc: string
  name-range: range = range/null
  provenance: import-provenance = ImportUser;

pub fun kimport/show(i: kimport): string
  "Kimport(" ++ i.importName.name/name/show ++ "," ++ i.package.show ++ "," ++ i.visibility.show ++ "," ++ i.doc.show ++ ")"

pub alias externals = list<external>;
pub type external
  External
    externName: name
    typeScheme: ktype //scheme
    params: list<param-info>
    format: string // always for a specific target platform
    visibility: visibility
    fipT: fipT
    rng: range
    doc: string
  ExternalImport
    imports: list<(string, string)> // always for a specific target platform
    rng: range

pub fun external/show(e: external): div string
  match e
    External(name, typeScheme, params, format, visibility, fipT, rng, doc) ->
      "External(" ++ name.name/name/show ++ "," ++ typeScheme.show ++ "," ++ params.show-list(show) ++ "," ++
      format.show ++ "," ++ visibility.show ++ "," ++ fipT.show ++ "," ++ rng.show ++ "," ++ doc.show ++ ")"
    ExternalImport(imports, rng) ->
      "ExternalImport(" ++ imports.show-list(fn((s1, s2)) s1.show ++ ":" ++ s2.show) ++ "," ++ rng.show ++ ")"

pub fun external/vis(e: external)
  match e
    External(visibility=v) -> v
    _ -> Private

pub fun external-import-lookup(b: buildType, key: string, e: external): maybe<string>
  match e
    ExternalImport(imports, _) -> b.eimport-lookup(key, imports)
    _ -> Nothing

pub fun eimport-lookup(b: buildType, s: string, ls: list<(string, string)>): maybe<string>
  val l = ls.find(_.fst == s ++ "-" ++ b.show)
  match l
    Just(i) -> Just(i.snd)
    Nothing -> 
      match ls.find(_.fst == s)
        Just(i) -> Just(i.snd)
        Nothing -> Nothing


pub type typedef
  Synonym(i: syn-info) // name, synonym info, and the visibility
  Data(info: data-info) //  name, info, visibility, and the visibilities of the constructors, the isExtend is true if this is an extension of the datatype.

pub fun td/show(t: typedef): string
  match t
    Synonym(i) -> "Synonym(" ++ i.show ++ ")"
    Data(i) -> "Data(" ++ i.show ++ ")"

pub alias typedef-groups = list<typedef-group>
pub alias typedef-group = typedefs
pub alias typedefs = list<typedef>

pub fun td/name(t: typedef): name
  match t
    Synonym(info) -> info.name
    Data(info) -> info.name

pub fun td/is-extension(t: typedef): bool
  match t
    Data(d) -> d.is-extend
    _ -> False

pub fun td/vis(t: typedef): visibility
  match t
    Synonym(info) -> vis(info)
    Data(info) -> vis(info)

pub fun tdgs/flatten(tdgs:list<typedef-group>): list<typedef>
  tdgs.concat()

// Data representation
pub value type data-repr
  DataEnum // only singletons (as an enumeration)
  DataIso // only one constructor with one field  (isomorpic)
  DataSingleStruct // only one constructor (no tag needed)
  DataStructAsMaybe // one constructor with one field, and one singleton (allows optimized boxed representation that avoids allocation)
  DataStruct // compatible constructors (all raw or regular types) and possibly singletons (need tag)
  // non-value types
  DataSingle(hasSingletons: bool) // only one constructor (no tag needed), hasSingletons true if it is a singleton as well
  DataAsMaybe // one constructor with one (non-recursive) field, and one singleton
  DataAsList // one constructor with fields, and one singleton (don't need a tag, for example can distinguish pointer vs enum)
  DataSingleNormal // one constructor with fields, and multiple singletons (distinguish one pointer vs enums)
  DataNormal(hasSingletons: bool)
  DataOpen;

pub fun isDataStructOrLess(d: data-repr): bool
  match d
    DataEnum -> True
    DataIso -> True
    DataSingleStruct -> True
    DataStructAsMaybe -> True
    DataStruct -> True
    _ -> False

pub fun show(d: data-repr): string
  match d
    DataEnum -> "DataEnum"
    DataIso -> "DataIso"
    DataSingleStruct -> "DataSingleStruct"
    DataStructAsMaybe -> "DataStructAsMaybe"
    DataStruct -> "DataStruct"
    DataSingle(b) -> "DataSingle(" ++ b.show ++ ")"
    DataAsMaybe -> "DataAsMaybe"
    DataAsList -> "DataAsList"
    DataSingleNormal -> "DataSingleNormal"
    DataNormal(b) -> "DataNormal(" ++ b.show ++ ")"
    DataOpen -> "DataOpen"

pub type con-repr
  ConEnum(n: name, repr: data-repr, vrepr: value-repr, tag: int) // part of enumeration (none has fields)
  ConIso(n: name, repr: data-repr, vrepr: value-repr, tag: int) // one constructor with one field
  ConSingleton(n: name, repr: data-repr, vrepr: value-repr, tag: int) // constructor without fields (and not part of an enum)
  ConSingle(n: name, repr: data-repr, vrepr: value-repr, ctxPath: ctx-path, tag: int) // there is only one constructor and it is not iso or singleton (and this is it)
  ConAsJust(n: name, repr: data-repr, vrepr: value-repr, asNothing: name, tag: int) // constructor is the just node of a maybe-like datatype  (only use for DataAsMaybe, not for DataStructAsMaybe)
  ConStruct(n: name, repr: data-repr, vrepr: value-repr, tag: int) // constructor as value type
  ConAsCons(n: name, repr: data-repr, vrepr: value-repr, asNil: name, ctxPath: ctx-path, tag: int) // constructor is the cons node of a list-like datatype  (may have one or more fields)
  ConOpen(n: name, repr: data-repr, vrepr: value-repr, ctxPath: ctx-path) // constructor of open data type
  ConNormal(n: name, repr: data-repr, vrepr: value-repr, ctxPath: ctx-path, tag: int); // a regular constructor
pub fun tag(c: con-repr): _ int
  match c
    ConEnum(tag=tag) -> tag
    ConIso(tag=tag) -> tag
    ConSingleton(tag=tag) -> tag
    ConSingle(tag=tag) -> tag
    ConAsJust(tag=tag) -> tag
    ConStruct(tag=tag) -> tag
    ConAsCons(tag=tag) -> tag
    ConOpen(_) -> throw("core/core: tag: open constructor")
    ConNormal(tag=tag) -> tag

pub fun update-ctx-path(c: con-repr, cp: ctx-path)
  match c
    ConSingle(n, r, v, _, t) -> ConSingle(n, r, v, cp, t)
    ConAsCons(n, r, v, a, _, t) -> ConAsCons(n, r, v, a, cp, t)
    ConOpen(n, r, v, _) -> ConOpen(n, r, v, cp)
    ConNormal(n, r, v, _, t) -> ConNormal(n, r, v, cp, t)
    _ -> throw("core/core: update-ctx-path: not a constructor with a path")

// The constructor-context path stamped on this OCCURRENCE's repr by
// AnalysisCCtx/CTail: Nothing for value types and
// for constructor shapes that carry no path field.
pub fun con-repr-ctx-path(c: con-repr): maybe<ctx-path>
  if c.con/is-value then Nothing else
    match c
      ConSingle(ctxPath=cp) -> Just(cp)
      ConAsCons(ctxPath=cp) -> Just(cp)
      ConNormal(ctxPath=cp) -> Just(cp)
      ConOpen(ctxPath=cp) -> Just(cp)
      _ -> Nothing

pub fun con-repr-has-ctx-path(c: con-repr): bool
  c.con-repr-ctx-path.is-just

pub fun con-repr/show(r: con-repr): string
  match r
    ConEnum(n, drepr, vrepr, tag) -> "ConEnum(" ++ n.name/name/show ++ "," ++ show(drepr) ++ "," ++ show(vrepr) ++ "," ++ tag.int/show ++ ")"
    ConIso(n, drepr, vrepr, tag) -> "ConIso(" ++ n.name/name/show ++ "," ++ show(drepr) ++ "," ++ show(vrepr) ++ "," ++ tag.int/show ++ ")"
    ConSingleton(n, drepr, vrepr, tag) -> "ConSingleton(" ++ n.name/name/show ++ "," ++ show(drepr) ++ "," ++ show(vrepr) ++ "," ++ tag.int/show ++ ")"
    ConSingle(n, drepr, vrepr, ctxPath, tag) -> "ConSingle(" ++ n.name/name/show ++ "," ++ show(drepr) ++ "," ++ show(vrepr) ++ "," ++ show(ctxPath) ++ "," ++ tag.int/show ++ ")"
    ConAsJust(n, drepr, vrepr, asNothing, tag) -> "ConAsJust(" ++ n.name/name/show ++ "," ++ show(drepr) ++ "," ++ show(vrepr) ++ "," ++ asNothing.name/name/show ++ "," ++ tag.int/show ++ ")"
    ConStruct(n, drepr, vrepr, tag) -> "ConStruct(" ++ n.name/name/show ++ "," ++ show(drepr) ++ "," ++ show(vrepr) ++ "," ++ tag.int/show ++ ")"
    ConAsCons(n, drepr, vrepr, asNil, ctxPath, tag) -> "ConAsCons(" ++ n.name/name/show ++ "," ++ show(drepr) ++ "," ++ show(vrepr) ++ "," ++ asNil.name/name/show ++ "," ++ show(ctxPath) ++ "," ++ tag.int/show ++ ")"
    ConOpen(n, drepr, vrepr, ctxPath) -> "ConOpen(" ++ n.name/name/show ++ "," ++ show(drepr) ++ "," ++ show(vrepr) ++ "," ++ show(ctxPath) ++ ")"
    ConNormal(n, drepr, vrepr, ctxPath, tag) -> "ConNormal(" ++ n.name/name/show ++ "," ++ show(drepr) ++ "," ++ show(vrepr) ++ "," ++ show(ctxPath) ++ "," ++ tag.int/show ++ ")"

pub type ctx-path
  CtxNone
  CtxField(name: tName)

pub fun ctxPath/show(p: ctx-path): string
  match p
    CtxNone -> "CtxNone"
    CtxField(name) -> "CtxField(" ++ name.show ++ ")"

// Value data is not heap allocated and needs no header
pub fun has-ctx-path(repr: con-repr): bool
  repr.ctx-path.is-just

pub fun ctx-path(repr: con-repr): maybe<ctx-path>
  if repr.is-value then Nothing 
  else match repr
    ConSingle(ctxPath=cpath) -> Just(cpath)
    ConAsCons(ctxPath=cpath) -> Just(cpath)
    ConNormal(ctxPath=cpath) -> Just(cpath)
    ConOpen(ctxPath=cpath) -> Just(cpath)
    _ -> Nothing

pub fun scan-count(repr: con-repr)
  scan-count(repr.vrepr)

pub fun alloc-size(c: con-repr, p: platform)
  c.alloc-size-scan(p).fst

pub fun alloc-size-scan(c: con-repr, p: platform): (int, int)
  val (sz, sc) = p.scan-size(c.vrepr)
  if c.is-value then (0, sc) else (sz, sc)

pub fun dataRepr/is-value(d: data-repr): bool
  match d
    DataEnum -> True
    DataIso -> True
    DataSingleStruct -> True
    DataStructAsMaybe -> True
    DataStruct -> True
    _ -> False

pub fun needsTagField(d: data-repr): bool
  match d
    DataStruct -> True
    DataStructAsMaybe -> True
    _ -> False

pub fun con/is-value(c: con-repr): bool
  c.repr.is-value

pub fun data/is-value(d: data-info): bool
  d.def.is-value

pub fun con-repr(d: data-info, c: con-info)
  val (_, creprs) = d.data-repr(is-value)
  match d.constrs.zip(creprs).filter(fn((a, _)) a.name == c.name).map(snd)
    [crepr] -> crepr
    _ -> throw("core/core: conRepr: constructor not in the datatype")

pub fun data-repr(i: data-info, is-val: (data-info) -> bool): _ (data-repr, list<con-repr>)
  val typeName = i.name
  val conInfos = i.constrs
  val tags = list(0, conInfos.length - 1)
  val singletons = conInfos.filter(_.params.is-nil)
  val hasExistentials = conInfos.any(_.existentials.is-cons)
  val is-value = is-val(i) && !i.is-rec
  val (dataRepr, conReprFuns) = 
    if i.is-open then (DataOpen, conInfos.map(fn(ci) fn(ctag) ConOpen(typeName, DataOpen, ci.valueRepr, CtxNone)))
    elif is-value && (i.params.is-nil || typeName == nameTpFieldAddr) && conInfos.all(fn(c) c.params.is-nil) then
      (DataEnum, conInfos.map(fn(ci) fn(ctag) ConEnum(typeName, DataEnum, ci.valueRepr, ctag)))
    elif conInfos.length == 1 then
      val conInfo = conInfos.head.unjust
      val dataRepr = 
        if is-value && conInfo.params.length == 1 then DataIso
        elif is-value && singletons.is-nil && !i.is-rec then DataSingleStruct
        else DataSingle(singletons.is-cons)
      (dataRepr, [if is-value && conInfo.params.length == 1 then fn(tag) ConIso(typeName, dataRepr, conInfo.valueRepr, tag)
                  elif singletons.length == 1 then fn(tag) ConSingleton(typeName, dataRepr, conInfo.valueRepr, tag)
                  else fn(tag) ConSingle(typeName, dataRepr, conInfo.valueRepr, CtxNone, tag)])
    elif is-value && !i.is-rec then
      val dataRepr = if conInfos.length == 2 && singletons.length == 1 && conInfos.filter(_.params.length == 1).length == 1 then DataStructAsMaybe else DataStruct
      (dataRepr, conInfos.map(fn(c) if c.params.is-nil then fn(tag) ConSingleton(typeName, dataRepr, c.valueRepr, tag) else fn(tag) ConStruct(typeName, dataRepr, c.valueRepr, tag)))
    else
      if conInfos.length == 2 && singletons.length == 1 then
        // note: for now we can only handle a true maybe type with a single Just constructor
        // with a parametric type so it is always kk_box_t at runtime.
        val maybeLike = match conInfos.filter(_.params.length == 1)
          [cinfo] -> match cinfo.params
            [(_, TVar)] -> True // single field of type 'a
            _ -> False
          _ -> False
        if !i.is-rec && maybeLike then
          (DataAsMaybe, conInfos.map(fn(c) if c.params.is-nil then fn(tag) ConSingleton(typeName, DataAsMaybe, c.valueRepr, tag) else fn(tag) ConAsJust(typeName, DataAsMaybe, c.valueRepr, singletons.head.unjust.name, tag)))
        else (DataAsList, conInfos.map(fn(c) if c.params.is-nil then fn(tag) ConSingleton(typeName, DataAsList, c.valueRepr, tag) else fn(tag) ConAsCons(typeName, DataAsList, c.valueRepr, singletons.head.unjust.name, CtxNone, tag)))
      else
        val dataRepr = if singletons.length == conInfos.length - 1 || conInfos.is-nil then DataSingleNormal else DataNormal(singletons.is-cons)
        (dataRepr, conInfos.map(fn(c) if c.params.is-nil then fn(tag) ConSingleton(typeName, dataRepr, c.valueRepr, tag) else fn(tag) ConNormal(typeName, dataRepr, c.valueRepr, CtxNone, tag)))
  (dataRepr, conReprFuns.map-indexed(fn(index, c) c(index + 1)))


// Definition Groups
pub alias def-groups = list<def-group>

pub fun dgs/flatten(dgs: list<def-group>): list<def>
  dgs.map(fn(d) match d {DefRec(dfs) -> dfs; DefNonRec(d) -> [d]}).concat()

pub fun list/flatten(dgs: list<def-groups>): list<def>
  dgs.map(flatten).concat()

pub fun dg/flatten(dg: def-group): list<def>
  match dg
    DefRec(defs) -> defs 
    DefNonRec(d) -> [d]

pub fun dg/map(dg: def-group, f: (def) -> e def): e def-group
  match dg
    DefRec(defs) -> DefRec(defs.map(f))
    DefNonRec(d) -> DefNonRec(f(d))

pub type def-group
  DefRec(defs: list<def>)
  DefNonRec(d: def)

pub fun dg/show(d: def-group): div string
  match d
    DefRec(defs) -> "DefRec(" ++ defs.show-list(show) ++ ")"
    DefNonRec(d') -> "DefNonRec(" ++ d'.show ++ ")"

// A value definition
pub struct def
  def-name: name
  ktype: ktype
  defExpr: expr
  vis: visibility // private public
  sort: def-sort // fun / val / var
  kinline: def-inline // auto / always, never
  nameRange: range
  doc: string;

pub fun def/show(d: def): div string
  "Def(" ++ d.def-name.name/name/show ++ "," ++ d.ktype.show ++ "," ++ d.defExpr.show ++ "," ++ d.vis.show ++ "," ++
  d.sort.show ++ "," ++ d.kinline.show ++ "," ++ d.nameRange.show ++ "," ++ d.doc.show ++ ")"

pub type inline-def
  InlineDef(
    def-name: name,
    expr: expr,
    is-rec: bool,
    kind: def-inline,
    cost: int,
    sort: def-sort, // for borrow information
    paramSpecialize: list<bool>
  )

pub fun idef/(==)(inl1: inline-def, inl2: inline-def): bool
  name/(==)(inl1.def-name, inl2.def-name)

pub fun idef/show(inl: inline-def): div string
  "InlineDef(" ++ inl.def-name.name/name/show ++ "," ++ inl.expr.show ++ "," ++ inl.is-rec.show ++ "," ++ inl.kind.show ++ "," ++ inl.cost.int/show ++ "," ++ inl.sort.show ++ "," ++ inl.paramSpecialize.show-list(show) ++ ")"

pub fun def/is-val(d: def): bool
  !d.sort.is-defFun

pub fun param-infos(d: def)
  match d.sort
    DefFun(i) -> i
    _ -> Nil

pub fun isSpecialize(inl: inline-def)
  inl.paramSpecialize.is-cons


pub effect core-phase
  fun get-core-defs(): def-groups
  fun set-core-defs(dgs: def-groups): ()
  fun phaseError(s: string): a

// Expressions
// Since this is System-F, all binding sites are annotated with their type.
pub type expr
  // Core lambda calculus
  Lam(names: list<tName>, eff: ktype, e: expr)
  Var(n: tName, info: var-info) // typed name and possible type-arity/parameter arity tuple for top-level functions
  App(f: expr, args: list<expr>) // always fully applied!
  TypeLam(args: list<type-var>, e: expr) // Type (universal) abstraction/application
  TypeApp(f: expr, types: list<ktype>)
  // Literals, constants and labels
  Con(n: tName, repr: con-repr) // typed name and its representation
  ELit(lit: lit)
  // Let
  Let(defs: list<def-group>, e: expr)
  // Case expressions
  Case(exprs: list<expr>, branches: list<branch>);

pub fun expr/show(e0: expr): div string
  match e0
    Lam(names, eff, e) -> "Lam(" ++ names.show-list(show) ++ "," ++ eff.show ++ "," ++ e.show ++ ")"
    Var(n, info) -> "Var(" ++ n.show ++ "," ++ info.show ++ ")"
    App(f, args) -> "App(" ++ f.show ++ "," ++ args.show-list(show) ++ ")"
    TypeLam(args, e) -> "TypeLam(" ++ args.show-list(show) ++ "," ++ e.show ++ ")"
    TypeApp(f, types) -> "TypeApp(" ++ f.show ++ "," ++ types.show-list(show) ++ ")"
    Con(n, repr) -> "Con(" ++ n.show ++ "," ++ repr.show ++ ")"
    ELit(lit) -> "ELit(" ++ lit.show ++ ")"
    Let(defs, e) -> "Let(" ++ defs.show-list(show) ++ "," ++ e.show ++ ")"
    Case(exprs, branches) -> "Case(" ++ exprs.show-list(show) ++ "," ++ branches.show-list(show) ++ ")"

pub struct branch
  patterns: list<pattern> // length = length exprs in the match
  guards: list<guard>; // any number (>= 1) of guarded expressions

pub fun branch/show(b: branch): div string
  "Branch(" ++ b.patterns.show-list(show) ++ "," ++ b.guards.show-list(show) ++ ")"

pub struct guard
  test: expr // boolean
  body: expr; // body of the branch

pub fun guard/show(g: guard): div string
  "Guard(" ++ g.test.show ++ "," ++ g.body.show ++ ")"

pub type pattern
  PatCon
    patName: tName // names the constructor with full signature.
    pattern: list<pattern> // sub-patterns. fully materialized to match arity.
    repr: con-repr // representation of ctor in backend.
    typeArgs: list<ktype> // zipped with patConPatterns
    kexists: list<type-var> // closed under existentials here
    typeRes: ktype // result type
    info: con-info // other constructor info
    skip: bool // skip testing for this constructor (as it should match already)
  PatVar(varName: tName, pattern: pattern) // name / type of variable and named subpattern
  PatLit(lit: lit)
  PatWild

pub fun pattern/show(p: pattern): div string
  match p
    PatCon(name, pattern, repr, typeArgs, kexists, typeRes, info, skip) -> 
      "PatCon(" ++ name.show ++ "," ++ pattern.show-list(show) ++ "," ++ repr.show ++ "," ++ 
      typeArgs.show-list(show) ++ "," ++ kexists.show-list(show) ++ "," ++ typeRes.show ++ "," ++ info.show ++ "," ++ skip.show ++ ")"
    PatVar(name, pattern) -> "PatVar(" ++ name.show ++ "," ++ pattern.show ++ ")"
    PatLit(lit) -> "PatLit(" ++ lit.show ++ ")"
    PatWild -> "PatWild"

pub type lit
  LitInt(i: int)
  LitFloat(d: float64)
  LitChar(c: string)
  LitString(s: string)

pub fun lit/(==)(l1: lit, l2: lit): bool
  match (l1, l2)
    (LitInt(i1), LitInt(i2)) -> i1 == i2
    (LitFloat(d1), LitFloat(d2)) -> d1 == d2
    (LitChar(c1), LitChar(c2)) -> c1 == c2
    (LitString(s1), LitString(s2)) -> s1 == s2
    _ -> False

pub fun lit/show(l: lit): string
  match l
    LitInt(i) -> "LitInt(" ++ i.int/show ++ ")"
    LitFloat(d) -> "LitFloat(" ++ d.show ++ ")"
    LitChar(c) -> "LitChar(" ++ c.show ++ ")"
    LitString(s) -> "LitString(" ++ s.show ++ ")"

pub type var-info
  InfoNone
  InfoArity(t: int, p: int) // type parameters, parameters
  InfoExternal(b: string) // inline body (always for a specific target platform)
  InfoReuse(p: pattern) 
  InfoConField(cName: tName, repr: con-repr, fName: tName) // constructor name, field name

pub value struct tName
  get-name: name
  tNameType: ktype

pub fun tn/(==)(tn1: tName, tn2: tName): bool
  tn1.get-name == tn2.get-name

pub fun tn/show(n: tName): string
  n.get-name.name/name/show

pub fun defTName(d: def): tName
  TName(d.def-name, d.ktype)

pub fun defsTNames(defs: list<def>): list<tName>
  defs.map(defTName)

fun def-groupTNames(dg: def-group): list<tName>
  match dg
    DefRec(defs) -> defsTNames(defs)
    DefNonRec(d) -> [defTName(d)]

fun def-groupsTNames(dgs: list<def-group>): list<tName>
  dgs.map(def-groupTNames).concat()

pub fun varInfo/show(v: var-info): string
  match v
    InfoNone -> ""
    InfoReuse -> "reuse:<pat>"
    InfoConField(n, _, fName) -> "field: " ++ n.show ++ "." ++ fName.show
    InfoArity(m, n) -> "arity:" ++ m.int/show ++ "," ++ n.int/show
    InfoExternal(b) -> "external:" ++ b

pub fun arity(v: var-info): int
  match v
    InfoArity(_, n) -> n
    _ -> 0

fun type-arity(v: var-info): int
  match v
    InfoArity(n, _) -> n
    _ -> 0

pub fun is-local(i: var-info): bool
  match i
    InfoNone -> True
    InfoReuse -> True
    _ -> False

pub fun isRefCounted(i: var-info)
  i.is-local

pub fun expr/is-total(e: expr): _ bool
  match e
    Lam -> True
    Var -> True
    TypeLam(_, ex) -> ex.is-total
    TypeApp(ex, _) -> ex.is-total
    Con -> True
    ELit -> True
    Let(dgs, ex) -> dgs.flatten.all(is-total) && ex.is-total
    Case(exps, brnchs) -> exps.all(is-total) && brnchs.all(is-total)
    App(f, args) -> f.is-total-fun && args.all(is-total)

pub fun branch/is-total(b: branch): _ bool
  b.guards.all(is-total)

pub fun guard/is-total(g: guard): _ bool
  g.body.is-total

fun expr/is-total-fun(e: expr): _ bool
  match e
    Lam(_, _, b) -> b.is-total
    TypeLam(_, ex) -> ex.is-total-fun
    TypeApp(ex, _) -> ex.is-total-fun
    Con -> True
    ELit -> True
    Let(dgs, e1) -> dgs.flatten.all(is-total) && e1.is-total-fun
    Case(exps, brnchs) -> exps.all(is-total-fun) && brnchs.all(is-total-fun)
    App(f, args) -> e.type-of.has-total-effect && f.is-total-fun && args.all(is-total)
    Var(v) -> v.get-name == nameBox || v.get-name == nameUnbox

fun branch/is-total-fun(b: branch): _ bool
  b.guards.all(is-total-fun)

fun guard/is-total-fun(g: guard): _ bool
  g.body.is-total-fun

pub fun def/is-total(d: def): _ bool
  d.defExpr.is-total

pub fun has-total-effect(tp: ktype): _ bool
  match tp.split-fun-scheme
    Nothing -> False
    Just((_, _, eff, _)) -> eff.is-type-total

pub fun is-mon-type(tp: ktype): _ bool
  if tp.kind == kindEffect then tp.is-mon-effect
  else match tp.expand-syn
    TForAll(_, t) -> t.is-mon-type
    TFun(_, eff, _) -> eff.is-mon-effect
    _ -> False

pub fun is-mon-effect(eff: ktype): _ bool
  val (ls, tl) = eff.extract-effect-extend
  !tl.is-effect-empty || ls.any(fn(l) match l.get-operation-effect() {Just((ResumeMany, _)) -> True; _ -> False})

pub fun is-inlineable(d: def, max: int): _ bool
  match d.kinline
    InlineAlways -> True
    InlineNever -> False
    _ -> d.cost <= max

val costInf = 1000

pub fun def/cost(d: def): _ int
  val n = d.cost-local
  if d.is-val then if n == 0 then 0 else costInf else n

fun cost-local(d: def): _ int
  d.defExpr.cost

pub fun dg/cost(dg: def-group): _ int
  match dg
    DefRec(defs) -> defs.map(cost-local).sum
    DefNonRec(def) -> cost-local(def)

pub fun expr/cost(e0: expr): _ int
  match e0
    Var(tn) | tn.get-name.is-hidden-external-name -> costInf
    Lam(_, _, b) -> 0 + b.cost
    Var -> 0
    App(e, args) -> 1 + e.cost + args.map(cost).sum
    TypeLam(_, e) -> e.cost
    TypeApp(e, _) -> e.cost
    Con -> 0
    ELit -> 0
    Let(dgs, b) -> dgs.map(cost).sum + b.cost
    Case(exprs, branches) -> (branches.length - 1) + exprs.map(cost).sum + branches.map(cost).sum

pub fun branch/cost(b: branch): _ int
  b.guards.map(cost).sum

pub fun guard/cost(g: guard): _ int
  g.test.cost + g.body.cost

fun expr/type-arity(e: expr): _ int
  e.type-of.type-arities.fst

fun param-arity(e: expr): _ int
  e.type-of.type-arities.snd

fun get-effect(e: expr): keffect
  match e
    Lam(_, eff, _) -> eff
    TypeLam(_, Lam(_, eff, _)) -> eff
    _ -> effectEmpty

