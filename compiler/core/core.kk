// TODO: More here

// Type variables

pub val tnames/empty: rbset<tName> = rb-set/empty()

pub fun tnames(l: list<tName>): rbset<tName>
  rb-set/from-list(l)

// Compares the NAMES only
pub fun cmp(t1: tName, t2: tName): order
  name/name/cmp(t1.get-name, t2.get-name)


pub fun make-let(defs: list<def-group>, expr: expr): expr
  match defs
    Nil -> expr
    _ -> match expr
      Let(defs', body) -> Let(defs ++ defs', body)
      _ -> Let(defs, expr)

pub fun make-type-app(e: expr, l: list<ktype>): expr
  match l
    Nil -> e
    _ -> match e
      TypeApp(e1, l') -> TypeApp(e1, l ++ l')
      _ -> TypeApp(e, l)

pub fun add-apps(l: list<expr>, e: expr)
  match l
    Nil -> e
    _ -> match e
      App(e1, l') -> App(e1, l ++ l')
      _ -> App(e, l)

pub fun add-type-apps(l: list<type-var>, e: expr)
  match l
    Nil -> e
    _ -> match e
      TypeApp(e', l') -> TypeApp(e', l' ++ l.map(TVar))
      _ -> TypeApp(e, l.map(TVar))

pub fun add-type-lambdas(l: list<type-var>, e: expr)
  match l
    Nil -> e
    _ -> match e
      TypeLam(l', e') -> TypeLam(l ++ l', e')
      _ -> TypeLam(l, e)

pub fun list2/add-lambdas(l: list<(name, ktype)>, effT: ktype, e: expr)
  match l
    Nil -> e
    _ -> match e
      Lam(l', _, e') -> Lam(l.map(fn((n, t)) TName(n, t)) ++ l', effT, e')
      _ -> Lam(l.map(fn((n, t)) TName(n, t)), effT, e)

pub fun list/add-lambdas(l: list<tName>, effT: ktype, e: expr)
  match l
    Nil -> e
    _ -> match e
      Lam(l', _, e') -> Lam(l ++ l', effT, e')
      _ -> Lam(l, effT, e)

fun add-non-rec(x: name, tp: ktype, e: expr, e': expr)
  Let([DefNonRec(Def(x, tp, e, Private, if e.is-value then DefVal else DefFun([]), InlineAuto, null, ""))], e')

pub fun is-value(e: expr): bool
  match e
    TypeLam(_, Lam) -> False
    Lam -> False
    _ -> True

pub fun add-core-def(c: core, d: def): core
  c(defs = c.defs ++ [DefNonRec(d)])

pub fun core/null(n: name)
  Core(n)

pub fun has-no-effect(e: expr)
  match e
    TypeApp(e) -> e.has-no-effect
    ELit -> True
    Con -> True
    _ -> False

pub fun open-effect(effFrom: keffect, effTo: keffect, tpFrom: ktype, tpTo: ktype, expr: expr)
  if expr.has-no-effect then expr
  else
    val a = TypeVar(-1, kindStar, Bound)
    val b = TypeVar(-2, kindStar, Bound)
    val e1 = TypeVar(-3, kindEffect, Bound)
    val e2 = TypeVar(-4, kindEffect, Bound)
    val tpOpen = TForAll([e1, e2, a, b], TFun([(new-name("x"), tpFrom)], typeTotal, tpTo))
    val varOpen = Var(TName(nameEffectOpen, tpOpen), InfoExternal("#1"))
    App(TypeApp(varOpen, [effFrom, effTo, tpFrom, tpTo]), [expr])

pub fun make-int32(i: int): expr
  val int32 = Var(TName(nameInternalInt32, TFun([(nil, typeInt)], typeTotal, typeInt32)), InfoArity(1, 0))
  App(int32, [ELit(LitInt(i))])

pub fun make-ev-index(i: int)
  if i < 0 then throw("core/core make-ev-index: size_t < 0 " ++ i.int/show)
  val sizet = Var(TName(nameInternalSSizeT, TFun([(nil, typeInt)], typeTotal, typeEvIndex)), InfoArity(1, 0))
  App(sizet, [ELit(LitInt(i))])

pub fun make-sizet(i: int)
  if i < 0 then throw("core/core make-sizet: size_t < 0 " ++ i.int/show)
  val sizet = Var(TName(nameInternalSSizeT, TFun([(nil, typeInt)], typeTotal, typeSSizeT)), InfoArity(1, 0))
  App(sizet, [ELit(LitInt(i))])

pub fun def/type-of(d: def): ktype
  d.ktype

pub fun tn/type-of(tn: tName): ktype
  tn.tNameType

pub fun expr/type-of(expr: expr): _ ktype
  match expr
    Lam(pars, eff, expr) -> TFun(pars.map(fn((TName(name, tp))) (name, tp)), eff, expr.type-of)
    Var(tn) -> type-of(tn)
    Con(tn) -> type-of(tn)
    App(f, args) -> match f.type-of.split-fun-scheme
      Just((_, targs, eff, tres)) 
        | args.length == targs.length || targs.length == 0 -> tres
        | args.length > targs.length -> type-of(App(Var(TName("tmp".new-name, tres), InfoNone), args.drop(targs.length)))
        | True -> TFun(targs.drop(args.length), eff, tres)
      _ -> throw("core/core type-of(App..) Expected function TODO: Show real type")
    TypeLam(xs, e) -> TForAll(xs, e.type-of)
    TypeApp(e, []) -> e.type-of
    TypeApp(e, tps) ->
      val (tvs, tp1) = e.type-of.split-tforall
      tsubst(tvs.take(tps.length).zip(tps), tp1)
    ELit(l) -> l.type-of
    Let(_, e) -> e.type-of
    Case(_, branches) -> branches.head.unjust.type-of

pub fun branch/type-of(Branch(_, guards): branch): _ ktype
    match guards
      Cons(g, _) -> g.type-of
      _ -> throw("core/core type-of(Branch..) branch with no guards")

pub fun guard/type-of(Guard(_, expr): guard): _ ktype
  expr.type-of

pub fun lit/type-of(l: lit): ktype
  match l
    LitInt(_) -> typeInt
    LitFloat(_) -> typeFloat
    LitChar(_) -> typeChar
    LitString(_) -> typeString

pub fun externals/extract-signatures(es: externals): list<ktype>
  match es
    Cons(External(visibility=Public, typeScheme=t), rst) -> Cons(t, extract-signatures(rst))
    Cons(_, rst) -> extract-signatures(rst)
    Nil -> Nil

pub fun dgs/extract-signatures(d: def-groups): list<ktype>
  d.flatten.map(fn(d') d'.ktype)

pub fun core/extract-signatures(c: core): list<ktype>
  extract-signatures(c.externals) ++ extract-signatures(c.defs)

fun split-fun(tp: ktype): _ (list<(name, ktype)>, ktype)
  match tp.expand-syn
    TFun(args, _, res) -> (args, res)
    _ -> throw("core/core split-fun: expected function type")

// minimal type-variable substitution (cannot use type/typevar here: it imports core/core)
fun tsubst(sub: list<(type-var, ktype)>, tp: ktype): _ ktype
  if sub.is-empty then tp else
    match tp
      TVar(tv) -> match sub.find(fn((v, _)) v == tv)
        Just((_, t)) -> t
        Nothing -> tp
      TFun(args, eff, res) -> TFun(args.map(fn((n, t)) (n, tsubst(sub, t))), tsubst(sub, eff), tsubst(sub, res))
      TApp(t, ts) -> TApp(tsubst(sub, t), ts.map(fn(t') tsubst(sub, t')))
      TForAll(vars, t) -> TForAll(vars, tsubst(sub.filter(fn((v, _)) !vars.any(fn(w) w == v)), t))
      TSyn(syn, args, t) -> TSyn(syn, args.map(fn(t') tsubst(sub, t')), tsubst(sub, t))
      TCon -> tp

fun split-tforall(tp: ktype): _ (list<type-var>, ktype)
  match tp.expand-syn
    TForAll(tvs, t) -> (tvs, t)
    _ -> throw("core/core split-tforall: expected forall type")

pub alias deps = name-set
pub fun deps/unions(l: list<deps>): deps
  l.foldl(rb-set/empty(), fn(s: deps, a: deps) s + a)
pub fun tname/dep(t: tName): deps
  dep(t.get-name)
pub fun name/dep(n: name): deps
  if n.is-qualified then rb-set/empty() + n.qualifier else rb-set/empty()

pub fun idefscore/deps(l: list<inline-def>, c: core): _ deps
  deps/unions(l.map(_.expr.dep)) + c.deps

pub fun idefs/deps(l: list<inline-def>): _ deps
  deps/unions(l.map(_.expr.dep))

pub fun core/deps(c: core): _ deps
  val x0 : deps = deps/unions(c.defs.flatten.map(dep)) + deps/unions(c.typedefs.flatten.map(dep))
  val x1 : deps = rb-set/from-list(c.imports.filter(_.visibility.is-public).map(importName))
  x0 + x1 - c.coreName

pub fun td/dep(td: typedef): _ deps
  match td
    Synonym(info) -> info.tp.dep
    Data(info) -> deps/unions(info.constrs.map(_.typeScheme.dep))

pub fun ktype/dep(t: ktype): _ deps
  match t
    TForAll(_, rho) -> rho.dep
    TFun(args, eff, res) -> deps/unions(Cons(eff.dep, args.map(fn((_, t')) t'.dep))) + res.dep
    TCon(tc) -> tc.name.dep
    TVar -> rb-set/empty()
    TApp(tp, tps) -> tp.dep + deps/unions(tps.map(dep))
    TSyn(_, args, tp) -> tp.dep + deps/unions(args.map(dep))

pub fun def/dep(d: def): _ deps
  deps/unions([d.ktype.dep, d.defExpr.dep])

pub fun expr/dep(e: expr): _ deps
  match e
    Var(tn) -> tn.dep
    Lam(_, eff, body) -> eff.dep + body.dep
    App(e, args) -> deps/unions(Cons(e.dep, args.map(dep)))
    TypeLam(_, body) -> body.dep
    TypeApp(e, tps) -> e.dep + deps/unions(tps.map(dep))
    Con(tn) -> tn.dep
    ELit(_) -> rb-set/empty()
    Let(defs, body) -> deps/unions(Cons(body.dep, defs.flatten.map(dep)))
    Case(exprs, branches) -> deps/unions(exprs.map(dep) ++ branches.map(dep))

pub fun branch/dep(b: branch): _ deps
  deps/unions(b.patterns.map(dep)) + deps/unions(b.guards.map(dep))

pub fun guard/dep(g: guard): _ deps
  g.body.dep

pub fun pattern/dep(p: pattern): _ deps
  match p
    PatCon(tn, pats) -> tn.dep + deps/unions(pats.map(dep))
    PatVar(_, p) -> p.dep
    _ -> rb-set/empty()
